# Azure AI Foundry project endpoint
# Format: https://<resource_name>.services.ai.azure.com/api/projects/<project_name>
PROJECT_ENDPOINT=

# The name of the agent created in Module 2 or via src/foundry-agent/agent.py
AGENT_NAME=project-advisor

# (Optional) Override the port the web server listens on
# PORT=8000

# ---------------------------------------------------------------------------
# Auth mode: "obo" for On-Behalf-Of, "mi" for Managed Identity (default)
# ---------------------------------------------------------------------------
AUTH_MODE=obo

# ---------------------------------------------------------------------------
# OBO credential — from the Entra ID app registration used by Easy Auth
# Required when AUTH_MODE=obo
# ---------------------------------------------------------------------------
AZURE_TENANT_ID=<your-entra-tenant-id>
AZURE_CLIENT_ID=<your-app-registration-client-id>
AZURE_CLIENT_SECRET=<your-app-registration-client-secret>
